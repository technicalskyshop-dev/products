# ==========================================
# CURATED DISCOVERY BACKEND ENVIRONMENT CONFIG
# ==========================================

# Server Port and Node Environment
PORT=5001
NODE_ENV=development

# Database URL
# For Local Development (SQLite):
DATABASE_URL="file:./dev.db"
# For Production (PostgreSQL):
# DATABASE_URL="postgresql://db_user:db_password@localhost:5432/curated_discovery?schema=public"

# Admin Authentication & Security
# Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-secure-random-32-byte-secret-for-production"
JWT_EXPIRES_IN="7d"
ADMIN_COOKIE_NAME="curator_session"

# Frontend Origin for Strict CORS
FRONTEND_URL="http://localhost:5173"

# Affiliate Platform Allowed Redirect Hostnames (Comma-separated)
ALLOWED_REDIRECT_HOSTS="amazon.in,www.amazon.in,amzn.to,amzn.in,flipkart.com,www.flipkart.com,fkrt.it,fkrt.co"

# Optional Cloud Object Storage (e.g., Cloudinary or S3-compatible)
# Leave blank to use local secure upload handler
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""

# S3 Compatible Storage (Alternative)
# S3_BUCKET_NAME=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

