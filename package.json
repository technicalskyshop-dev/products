{
  "name": "product-discovery-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-build.mjs && vite build",
    "vercel-build": "node scripts/prepare-build.mjs && tsc && vite build",
    "preview": "vite preview",
    "server:dev": "tsx server/src/index.ts",
    "server:build": "tsc",
    "server:start": "node dist-server/src/index.js",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:generate:pg": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:seed": "tsx server/src/db/seed.ts",
    "db:activate-supabase": "node scripts/activate-supabase.mjs",
    "admin:bootstrap": "tsx server/src/db/bootstrapAdmin.ts",
    "test:backend": "tsx test/backend.test.ts",
    "tunnel:share": "cloudflared tunnel --url http://localhost:5173"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.16.0",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.3.1",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
